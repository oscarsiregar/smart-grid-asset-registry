# Copy to .env for local development. Never commit .env.
# In Kubernetes these come from Secret/ConfigMap env vars (they override .env).

APP_NAME=smart-grid-asset-registry
APP_ENV=dev                 # dev | staging | prod  (prod = JSON logs, quiet GORM logger)
APP_HOST=0.0.0.0
APP_PORT=8080
FIBER_PREFORK=false         # keep false on Kubernetes
# Reverse proxies whose X-Forwarded-For gives the client address (comma-separated
# CIDRs). Empty when the API is reached directly, as with "make run".
TRUSTED_PROXIES=

# Matches the compose "db" service (docker compose up db): host port 5432.
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=asset_registry
DB_PORT=5432
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=60
