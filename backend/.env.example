# Copy to .env for local development. Never commit .env.
# In Kubernetes these come from Secret/ConfigMap env vars (they override .env).

APP_NAME=backend-template-service
APP_ENV=dev                 # dev | staging | prod  (prod = JSON logs, quiet GORM logger)
APP_HOST=0.0.0.0
APP_PORT=3030
FIBER_PREFORK=false         # keep false on Kubernetes

DB_HOST=localhost
DB_USER=username
DB_PASSWORD=password
DB_NAME=db
DB_PORT=5432
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=60

# Shared with the BFF: every /v1 business route rejects requests without it.
INTERNAL_SERVICE_SECRET=
# Same secret identity-service signs JWTs with (JWTVerifyStrict).
JWT_SECRET=
