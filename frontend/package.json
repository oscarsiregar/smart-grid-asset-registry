{
	"name": "frontend-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"engines": {
		"node": "24.x.x",
		"pnpm": "11.x.x"
	},
	"scripts": {
		"start:dev": "vite",
		"build": "tsc -p tsconfig.build.json && vite build",
		"test": "vitest run",
		"preview": "vite preview",
		"lint:editor": "editorconfig-checker",
		"lint:fs": "ls-lint",
		"lint:type": "tsc --noEmit",
		"lint:js": "eslint . --max-warnings=0",
		"lint:css": "stylelint \"src/**/*.css\"",
		"lint:format": "prettier --check \"**/*.{ts,tsx,js,json,md,css,html}\"",
		"lint:trash": "knip",
		"lint": "concurrently \"pnpm:lint:*\"",
		"format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,html}\"",
		"git:hook:precommit": "lint-staged",
		"git:hook:commit": "commitlint --edit",
		"ci:prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:type && pnpm run git:hook:precommit",
		"commit-msg": "pnpm run git:hook:commit"
	},
	"dependencies": {
		"@hookform/resolvers": "5.5.8",
		"@reduxjs/toolkit": "2.12.0",
		"clsx": "2.1.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.84.0",
		"react-redux": "9.3.0",
		"react-router-dom": "7.18.2",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/types": "21.2.0",
		"@eslint/js": "10.0.1",
		"@ls-lint/ls-lint": "2.3.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@typescript-eslint/eslint-plugin": "8.65.0",
		"@typescript-eslint/parser": "8.65.0",
		"@vitejs/plugin-react": "6.0.5",
		"concurrently": "10.0.4",
		"editorconfig-checker": "7.0.0",
		"eslint": "10.8.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsdoc": "63.3.2",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-perfectionist": "5.10.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-sonarjs": "4.2.0",
		"eslint-plugin-unicorn": "72.0.0",
		"globals": "17.8.0",
		"jsdom": "31.0.1",
		"knip": "6.31.0",
		"lint-staged": "17.3.0",
		"prettier": "3.9.6",
		"simple-git-hooks": "2.13.1",
		"stylelint": "17.14.1",
		"stylelint-config-recess-order": "7.7.0",
		"stylelint-config-standard": "40.0.0",
		"typescript": "6.0.3",
		"vite": "8.2.0",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "5.1.0"
	}
}
